{
  "name": "church-management-api",
  "version": "1.0.0",
  "description": "Church Management System - Backend API",
  "main": "src/server.js",
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "./test/setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "test/finance.validator.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "moduleNameMapper": {
      "^uuid$": "<rootDir>/test/__mocks__/uuid.js"
    }
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "db:validate:3nf": "node scripts/validate-3nf-compatibility.js",
    "test:finance-validator": "node --test test/finance.validator.test.js",
    "test": "jest --detectOpenHandles --forceExit --testTimeout=15000",
    "test:coverage": "jest --coverage --detectOpenHandles --forceExit --testTimeout=15000",
    "demo:seed": "node scripts/demo-data.js seed",
    "demo:cleanup": "node scripts/demo-data.js cleanup"
  },
  "engines": {
    "node": "20.x"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "@sentry/node": "^10.56.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "csv-parse": "^6.2.1",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^3.0.1",
    "mysql2": "^3.18.2",
    "nodemailer": "^8.0.2",
    "pdfkit": "^0.19.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.17.4",
    "sequelize": "^6.37.8",
    "uuid": "^14.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.2.2"
  }
}
