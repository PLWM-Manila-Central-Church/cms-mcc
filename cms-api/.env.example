# ── PLWM-MCC Backend Environment Variables ──────────────────────
# Copy this to .env and fill in the values for your environment.
# Required variables are marked with ★.

# ★ DATABASE
DB_HOST=localhost
DB_PORT=4000
DB_NAME=plwm_mcc
DB_USER=root
DB_PASSWORD=

# ★ JWT AUTHENTICATION
# NOTE: the refresh secret is read as REFRESH_TOKEN_SECRET (not JWT_REFRESH_SECRET)
JWT_SECRET=
REFRESH_TOKEN_SECRET=
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# ★ SERVER
PORT=5000
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:3000,https://cms-mcc.vercel.app

# LOGGING
LOG_LEVEL=info

# MIGRATIONS
MIGRATE_ON_START=true

# ── Email (Brevo / Sendinblue) ─────────────────────────────────
BREVO_API_KEY=
SMTP_FROM=PLWM-MCC <noreply@example.com>
# Disabled by default. Enable only after approving the recipient data and Brevo configuration.
EMAIL_NOTIFICATION_DELIVERY_ENABLED=false

# ── File Storage (S3-compatible) ───────────────────────────────
# Local development uses the uploads/ folder when unset. Production uploads
# return 503 until durable storage is configured; Render's default filesystem
# is ephemeral.
# Supabase S3 endpoint: https://<project-ref>.storage.supabase.co/storage/v1/s3
# Use the region shown in the project's S3 settings; MCC uses Singapore.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── File Upload Limits ─────────────────────────────────────────
MAX_FILE_SIZE_MB=25

# ── Error Tracking (Sentry) ────────────────────────────────────
# SENTRY_DSN=

# ── Rate Limiting ──────────────────────────────────────────────
# Override default rate limits if needed
# LOGIN_RATE_LIMIT_MAX=10
# GLOBAL_RATE_LIMIT_MAX=150

# ── Metrics ────────────────────────────────────────────────────
# When set, GET /metrics requires this token (Authorization: Bearer <token>
# or ?token=<token>). Leave unset only in development.
# METRICS_TOKEN=
# Database and password-hashing options
DB_SSL=false
BCRYPT_ROUNDS=10

# Optional local metrics endpoint bearer token; Render generates this in production.
METRICS_TOKEN=
