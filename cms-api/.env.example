# ── PLWM-MCC Backend Environment Variables ──────────────────────
# Copy this to .env and fill in the values for your environment.
# Required variables are marked with ★.

# ★ DATABASE
DB_HOST=localhost
DB_PORT=4000
DB_NAME=plwm_mcc
DB_USER=root
DB_PASSWORD=

# ★ JWT AUTHENTICATION
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# ★ SERVER
PORT=5000
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:3000,https://cms-mcc.vercel.app

# LOGGING
LOG_LEVEL=info

# MIGRATIONS
MIGRATE_ON_START=true

# ── Email (Brevo / Sendinblue) ─────────────────────────────────
BREVO_API_KEY=
SMTP_FROM=PLWM-MCC <noreply@example.com>

# ── File Storage (S3-compatible) ───────────────────────────────
# Optional — falls back to local disk if not set.
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=plwm-mcc-uploads
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# CDN_URL=

# ── File Upload Limits ─────────────────────────────────────────
MAX_FILE_SIZE_MB=25

# ── Error Tracking (Sentry) ────────────────────────────────────
# SENTRY_DSN=

# ── Rate Limiting ──────────────────────────────────────────────
# Override default rate limits if needed
# LOGIN_RATE_LIMIT_MAX=10
# GLOBAL_RATE_LIMIT_MAX=150